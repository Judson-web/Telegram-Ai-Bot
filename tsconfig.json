{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "index.tsx",
    "lib/**/*.ts",
    "models/**/*.ts",
    "plugins/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}